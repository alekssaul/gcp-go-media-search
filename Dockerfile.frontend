# Dockerfile.frontend

FROM node:24-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=true
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY ./frontend/web/ui/package.json ./frontend/web/ui/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

FROM base AS final
WORKDIR /app  

COPY /frontend/web/ui /app
COPY ./frontend/web/ui/package.json ./app
COPY --from=deps /app/node_modules /app/node_modules


EXPOSE 5173
CMD [ "pnpm", "dev", "--host",  "0.0.0.0" ]